<Window x:Class="SAYA64Extreme.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SAYA64Extreme"
        xmlns:vm="clr-namespace:SAYA64Extreme.ViewModels"
        xmlns:models="clr-namespace:SAYA64Extreme.Models"
        Title="SAYA64 Extreme - System Information" 
        Height="750" Width="1100" MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PrimaryBgBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Preferences" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="ExitMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Refresh" Command="{Binding RefreshCommand}"/>
                <Separator/>
                <MenuItem Header="_Expand All" Click="ExpandAll_Click"/>
                <MenuItem Header="_Collapse All" Click="CollapseAll_Click"/>
            </MenuItem>
            <MenuItem Header="_Report">
                <MenuItem Header="Generate _HTML Report" Command="{Binding ExportReportCommand}"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Memory Benchmark" Command="{Binding RunBenchmarkCommand}"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About SAYA64 Extreme" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBarTray DockPanel.Dock="Top" Background="{StaticResource HeaderBgBrush}">
            <ToolBar Background="{StaticResource HeaderBgBrush}" Band="0" BandIndex="0">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" ToolTip="Refresh all data"/>
                <Separator/>
                <Button Content="Benchmark" Command="{Binding RunBenchmarkCommand}" ToolTip="Run Memory Benchmark"/>
                <Button Content="Report" Command="{Binding ExportReportCommand}" ToolTip="Generate HTML Report"/>
                <Separator/>
                <TextBlock Text="SAYA64 Extreme v2.0.0" VerticalAlignment="Center" 
                           Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Margin="8,0"/>
            </ToolBar>
        </ToolBarTray>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SubTextBrush}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding SensorUpdateInfo}" Foreground="{StaticResource SubTextBrush}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Main Content: 2-Pane Layout -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="180"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Pane: TreeView (Page Menu) -->
            <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <TreeView x:Name="CategoryTree" 
                          ItemsSource="{Binding Categories}"
                          SelectedItemChanged="CategoryTree_SelectedItemChanged"
                          Padding="4">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type models:CategoryNode}" 
                                                  ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="{Binding Icon}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <!-- GridSplitter -->
            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- Right Pane: Information Window -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Category Header -->
                <Border Grid.Row="0" Background="{StaticResource HeaderBgBrush}" Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectedCategoryIcon}" FontSize="20" 
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding SelectedCategoryName}" FontSize="16" 
                                   FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Data Display -->
                <DataGrid Grid.Row="1" 
                          ItemsSource="{Binding CurrentItems}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Property" Binding="{Binding Name}" Width="280">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="8,4"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
